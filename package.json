{
    "name": "tanplate",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
        "build": "vite build && cp instrument.server.mjs .output/server",
        "analyze": "vite build --mode analyze",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "i18n:compile": "bun scripts/compile-i18n.ts",
        "typecheck": "tsc --noEmit",
        "api:lint": "redocly lint catalog@v1 orders@v1 --config src/api/openapi/redocly.yaml",
        "api:bundle": "mkdir -p src/api/openapi/dist && redocly bundle catalog@v1 --config src/api/openapi/redocly.yaml --output src/api/openapi/dist/catalog.yaml && redocly bundle orders@v1 --config src/api/openapi/redocly.yaml --output src/api/openapi/dist/orders.yaml",
        "api:generate": "openapi-ts --file src/api/openapi-ts.config.ts",
        "api:watch": "openapi-ts --file src/api/openapi-ts.config.ts --watch",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:browser": "vitest run --project browser",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "prepare": "lefthook install",
        "start": "PORT=4001 bun --import ./.output/server/instrument.server.mjs ./.output/server/index.mjs",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@base-ui/react": "1.5.0",
        "@sentry/tanstackstart-react": "10.54.0",
        "@shikijs/langs": "4.1.0",
        "@shikijs/rehype": "4.1.0",
        "@shikijs/themes": "4.1.0",
        "@t3-oss/env-core": "0.13.11",
        "@t3-oss/env-nextjs": "0.13.11",
        "@tailwindcss/vite": "4.3.0",
        "@tanstack/react-devtools": "0.10.5",
        "@tanstack/react-form": "1.32.1",
        "@tanstack/react-form-devtools": "0.2.27",
        "@tanstack/react-query": "5.100.14",
        "@tanstack/react-query-devtools": "5.100.11",
        "@tanstack/react-router": "1.170.8",
        "@tanstack/react-router-devtools": "1.167.0",
        "@tanstack/react-router-ssr-query": "1.167.0",
        "@tanstack/react-start": "1.168.14",
        "@tanstack/react-table": "8.21.3",
        "@tanstack/router-plugin": "1.168.11",
        "@unpic/react": "1.0.2",
        "arctic": "3.7.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "dotenv-cli": "11.0.0",
        "gray-matter": "4.0.3",
        "hast-util-to-string": "3.0.1",
        "html-react-parser": "6.1.1",
        "lucide-react": "1.16.0",
        "nitro": "npm:nitro-nightly@3.0.260522-beta",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "rehype-autolink-headings": "7.1.0",
        "rehype-raw": "7.0.0",
        "rehype-sanitize": "6.0.0",
        "rehype-slug": "6.0.0",
        "rehype-stringify": "10.0.1",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "shiki": "4.1.0",
        "tailwind-merge": "3.5.0",
        "tailwindcss": "4.3.0",
        "unified": "11.0.5",
        "unist-util-visit": "5.1.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.97.2",
        "@inlang/paraglide-js": "2.18.1",
        "@inlang/plugin-m-function-matcher": "2.2.6",
        "@inlang/plugin-message-format": "4.4.0",
        "@playwright/test": "1.60.0",
        "@redocly/cli": "2.31.2",
        "@storybook/addon-docs": "10.4.0",
        "@storybook/tanstack-react": "10.4.0",
        "@tailwindcss/typography": "0.5.19",
        "@tanstack/devtools-vite": "0.7.0",
        "@types/node": "25.9.1",
        "@types/react": "19.2.15",
        "@types/react-dom": "19.2.3",
        "@vitejs/devtools": "0.2.0",
        "@vitejs/plugin-react": "6.0.2",
        "@vitest/browser-playwright": "4.1.7",
        "eslint-plugin-better-tailwindcss": "4.5.0",
        "lefthook": "2.1.8",
        "oxfmt": "0.51.0",
        "oxlint": "1.66.0",
        "storybook": "10.4.0",
        "typescript": "6.0.3",
        "vite": "8.0.14",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "4.1.7",
        "vitest-browser-react": "2.2.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss"
        ]
    },
    "trustedDependencies": [
        "@sentry/cli"
    ]
}
