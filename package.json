{
  "name": "tanplate",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "build": "vite build && cp instrument.server.mjs .output/server",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "start": "bun --import ./.output/server/instrument.server.mjs .output/server/index.mjs"
  },
  "dependencies": {
    "@sentry/tanstackstart-react": "10.54.0",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-form": "1.32.1",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-query-devtools": "5.100.11",
    "@tanstack/react-router": "1.170.8",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.0",
    "@tanstack/react-start": "1.168.14",
    "@tanstack/router-plugin": "1.168.11",
    "dotenv-cli": "11.0.0",
    "lucide-react": "1.16.0",
    "nitro": "npm:nitro-nightly@3.0.260522-beta",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@tanstack/devtools-vite": "0.7.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "4.1.7",
    "vite": "8.0.14",
    "vitest": "4.1.7",
    "vitest-browser-react": "2.2.0",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "trustedDependencies": [
    "@sentry/cli"
  ]
}
