{
    "name": "tanplate",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
        "build": "vite build && cp instrument.server.mjs .output/server",
        "analyze": "vite build --mode analyze",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix --quiet",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "i18n:compile": "bun scripts/compile-i18n.ts",
        "typecheck": "tsc --noEmit",
        "api:lint": "redocly lint catalog@v1 orders@v1 --config src/api/openapi/redocly.yaml",
        "api:bundle": "mkdir -p src/api/openapi/dist && redocly bundle catalog@v1 --config src/api/openapi/redocly.yaml --output src/api/openapi/dist/catalog.yaml && redocly bundle orders@v1 --config src/api/openapi/redocly.yaml --output src/api/openapi/dist/orders.yaml",
        "api:generate": "bun run api:lint && bun run api:bundle && kubb generate --config src/api/kubb.config.ts",
        "api:watch": "bun scripts/watch-api.ts",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:browser": "vitest run --project browser",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "prepare": "if [ -e .git ]; then lefthook install; fi",
        "start": "bun --import ./.output/server/instrument.server.mjs ./.output/server/index.mjs",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "api:check": "bun scripts/check-api-generated.ts"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@sentry/tanstackstart-react": "11.8.0",
        "@shikijs/langs": "4.5.0",
        "@shikijs/rehype": "4.5.0",
        "@shikijs/themes": "4.5.0",
        "@t3-oss/env-core": "0.13.11",
        "@t3-oss/env-nextjs": "0.13.11",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/react-devtools": "0.10.13",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-form-devtools": "0.2.34",
        "@tanstack/react-query": "5.104.3",
        "@tanstack/react-query-devtools": "5.104.3",
        "@tanstack/react-router": "1.170.44",
        "@tanstack/react-router-devtools": "1.167.2",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.2",
        "@tanstack/react-table": "9.3.1",
        "@tanstack/router-plugin": "1.168.46",
        "@unpic/react": "1.0.2",
        "arctic": "3.7.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "dotenv-cli": "11.0.0",
        "gray-matter": "4.0.3",
        "hast-util-to-string": "3.0.1",
        "html-react-parser": "6.1.8",
        "lucide-react": "1.57.0",
        "nitro": "3.0.260903-beta",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "rehype-autolink-headings": "7.1.0",
        "rehype-raw": "7.0.0",
        "rehype-sanitize": "6.0.0",
        "rehype-slug": "6.0.0",
        "rehype-stringify": "10.0.1",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "shiki": "4.5.0",
        "tailwind-merge": "3.7.0",
        "tailwindcss": "4.3.3",
        "unified": "11.0.5",
        "unist-util-visit": "5.1.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "2.28.0",
        "@inlang/plugin-m-function-matcher": "2.3.4",
        "@inlang/plugin-message-format": "4.5.4",
        "@playwright/test": "1.64.1",
        "@redocly/cli": "2.64.0",
        "@storybook/addon-docs": "10.6.2",
        "@storybook/tanstack-react": "10.6.2",
        "@tailwindcss/typography": "0.5.20",
        "@tanstack/devtools-vite": "0.8.5",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/devtools": "0.8.0",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/browser-playwright": "5.0.4",
        "eslint-plugin-better-tailwindcss": "4.9.1",
        "lefthook": "2.2.2",
        "oxfmt": "0.73.0",
        "oxlint": "1.88.0",
        "storybook": "10.6.2",
        "typescript": "7.0.2",
        "vite": "8.3.4",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "5.0.4",
        "vitest-browser-react": "2.3.0",
        "kubb": "5.10.0",
        "@kubb/adapter-oas": "5.10.0",
        "@kubb/plugin-ts": "5.0.11",
        "@kubb/plugin-zod": "5.4.9",
        "@kubb/plugin-fetch": "5.6.1",
        "@kubb/plugin-react-query": "5.5.0"
    },
    "trustedDependencies": [
        "@sentry/cli"
    ],
    "packageManager": "bun@1.4.2"
}
