# Sentry browser/server DSN. Leave empty to disable local Sentry.
VITE_SENTRY_DSN=

# Canonical site URL used when generating sitemap.xml during production builds.
SITE_URL=

# Go auth service base URL. The scaffold posts to /sign-in and /external/sign-in.
AUTH_BACKEND_URL=

# OAuth provider settings used by Arctic.
# Callback URLs default to /auth/<provider>/callback when left empty.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=
AUTH_GOOGLE_SCOPES=

AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_REDIRECT_URI=
AUTH_GITHUB_SCOPES=

AUTH_YANDEX_CLIENT_ID=
AUTH_YANDEX_CLIENT_SECRET=
AUTH_YANDEX_REDIRECT_URI=
AUTH_YANDEX_SCOPES=

AUTH_VK_CLIENT_ID=
AUTH_VK_CLIENT_SECRET=
AUTH_VK_REDIRECT_URI=
AUTH_VK_SCOPES=

# Sentry release upload settings. Required only when uploading source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
